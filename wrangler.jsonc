{
  // How Cloudflare Workers builds and serves the site. Other hosts don't
  // read this file. Your Worker's name on Cloudflare:
  "name": "my-portfolio",
  "compatibility_date": "2026-07-18",
  // Astro builds the site into dist/ before every deploy, and only dist/ is
  // served, so nothing else in the repo can be.
  "build": { "command": "npm run build" },

  // ---- Ask (optional) -------------------------------------------------------
  // Off: there's no Worker script, and every path is a file in dist/, which
  // is free on every Cloudflare plan. To turn it on, set `ask` in
  // site.config.ts, then uncomment this block (select it and toggle the
  // comment) and the two lines marked "Ask" in "assets". Workers AI, the
  // rate limit and the Durable Object are set up from this file on the next
  // deploy.
  //
  // Turn it on in an account on the Workers Free plan: there, anything past
  // Cloudflare's daily limits is refused, never billed. On Workers Paid the
  // same flood is billed, and the limits below are all that's in its way:
  // read "What Ask can cost" in the README first.
  //
  // // The one Worker script (src/worker, bundled by wrangler) answers POST
  // // /ask; a file is served without running it.
  // "main": "src/worker/index.ts",
  // // Workers AI, for /ask. Its free allowance resets daily; past it, /ask
  // // picks nothing and the page falls back to "Something else".
  // "ai": { "binding": "AI" },
  // // At most 10 questions a minute from one visitor (per Cloudflare
  // // location). namespace_id is any number, unique in your account.
  // "ratelimits": [{ "name": "ASK_LIMIT", "namespace_id": "4242", "simple": { "limit": 10, "period": 60 } }],
  // // And for the whole site a day's questions (ASK_DAILY_LIMIT) and what
  // // they may cost (ASK_DAILY_NEURONS), and a block on anyone who asks
  // // something inappropriate, kept in one Durable Object (AskGuard,
  // // src/worker/guard).
  // "durable_objects": { "bindings": [{ "name": "ASK_GUARD", "class_name": "AskGuard" }] },
  // "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AskGuard"] }],
  // // Visitors' addresses are hashed before they're counted. Set your own
  // // salt as a secret (`npx wrangler secret put ASK_SALT`); without it, a
  // // salt in the code is used, which anyone can read.
  // "vars": {
  //   // "false" turns /ask off without a code change (typed questions then
  //   // get the "Something else" reply).
  //   "ASK_ENABLED": "true",
  //   // Questions sent to the model per day (UTC), for the whole site.
  //   "ASK_DAILY_LIMIT": "200",
  //   // What those questions may cost per day, in Workers AI Neurons, for
  //   // the whole site. Each question's cost is counted from the tokens its
  //   // model calls used (the pick, Llama Guard reading the question, and
  //   // the reply written from the pick), and once the day's reach this no
  //   // more are asked until midnight UTC. Workers AI gives 10,000 free a
  //   // day; the 1,000 between is for the questions already on their way
  //   // when the budget is reached. What a question costs depends on how
  //   // much your site says, since the model reads every answer: each /ask
  //   // log line has it, as `neurons`.
  //   "ASK_DAILY_NEURONS": "9000",
  //   // Questions per visitor (hashed address) per day. With ten left (or a
  //   // third of a smaller limit) they're told how many; past it, that
  //   // asking runs on a free service. The lower this is, the more
  //   // addresses it takes to use up the site's day.
  //   "ASK_VISITOR_LIMIT": "30",
  //   // How long an address (hashed) can't use /ask after an inappropriate
  //   // question.
  //   "ASK_BLOCK_HOURS": "24",
  //   // Where AskGuard is created: a Durable Object location hint. It is
  //   // near Workers AI in North America; it stays where it was first
  //   // created, so changing this later doesn't move it.
  //   "ASK_GUARD_LOCATION": "enam",
  //   // Each /ask log line says which answer was picked and what it cost, or
  //   // why the question was turned away, and never the visitor's address.
  //   // "true" adds what was asked (`question`), what the model made of it
  //   // before it picked (`thought`), the numbers of the lines it chose
  //   // (`chose`), the names and numbers of a reply it wrote that those
  //   // lines don't have (`unsaid`) and the reply sent (`said`), to read
  //   // under the Worker's Observability tab until Workers Logs drops them
  //   // (3 days on the free plan). Off, so visitors' words aren't kept,
  //   // unless you choose to keep them and say so.
  //   "ASK_LOG_QUESTIONS": "false",
  //   // Any Workers AI text model with function calling;
  //   // src/worker/constants.ts has the settings and the prices for the
  //   // ones it's been tried with. Another model is counted at the dearest
  //   // of those prices unless ASK_MODEL_PRICE gives its own, as Neurons
  //   // for a million tokens read and a million written: "5500/36400".
  //   "ASK_MODEL": "@cf/zai-org/glm-4.7-flash"
  // },
  // ---- End of Ask -----------------------------------------------------------

  "assets": {
    "directory": "dist",
    // Ask: the Worker reaches the files through this binding, and runs
    // first for /ask (otherwise only for paths with no file).
    // "binding": "ASSETS",
    // "run_worker_first": ["/ask"],
    // Serve /404.html for paths that don't exist.
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
