{
  // How Cloudflare Workers builds and serves the site. Other hosts don't
  // read this file. Your Worker's name on Cloudflare:
  "name": "my-portfolio",
  "compatibility_date": "2026-07-18",
  // Astro builds the site into dist/ before every deploy, and only dist/ is
  // served, so nothing else in the repo can be.
  "build": { "command": "npm run build" },

  // ---- The Worker, for Ask and the contact form (optional) ----------------
  // Off: there's no Worker script, and every path is a file in dist/, which
  // is free on every Cloudflare plan. To turn on Ask (docs/ask.md), the
  // contact form (docs/contact-form.md) or both: set it in site.config.ts,
  // uncomment this block (select it and toggle the comment) and the two
  // lines marked "Worker" in "assets", then the block of each one you turn
  // on, below this one. What they bind is set up from this file on the next
  // deploy.
  //
  // Turn either on in an account on the Workers Free plan: there, anything
  // past Cloudflare's daily limits is refused, never billed. On Workers Paid
  // the same flood is billed, and the limits below are all that's in its
  // way: read "What Ask can cost" in docs/ask.md first.
  //
  // // The one Worker script (src/worker, bundled by wrangler) answers POST
  // // /ask and POST /contact; a file is served without running it.
  // "main": "src/worker/index.ts",
  // // For the whole site: a day's questions (ASK_DAILY_LIMIT) and what they
  // // may cost (ASK_DAILY_NEURONS), a block on anyone who asks something
  // // inappropriate, and a day's messages from the contact form
  // // (CONTACT_DAILY_LIMIT), kept in one Durable Object (AskGuard,
  // // src/worker/guard).
  // "durable_objects": { "bindings": [{ "name": "ASK_GUARD", "class_name": "AskGuard" }] },
  // "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AskGuard"] }],
  // // Visitors' addresses are hashed before they're counted, with the day
  // // in the hash: tomorrow's is another one, and what's kept under
  // // today's is deleted at midnight UTC. Set your own salt as a secret
  // // (`npx wrangler secret put ASK_SALT`). Without it a salt in the code
  // // is used, which anyone can read, so a stored hash could be worked
  // // back to its address by trying every address.
  // "vars": {
  //   // Ask's settings. A site without Ask can leave them as they are.
  //   //
  //   // "false" turns /ask off without a code change (typed questions then
  //   // get the "Something else" reply).
  //   "ASK_ENABLED": "true",
  //   // Questions sent to the model per day (UTC), for the whole site. No
  //   // more than a third of them are taken in any one hour, so a flood ends
  //   // Ask for the rest of that hour, not of the day.
  //   "ASK_DAILY_LIMIT": "200",
  //   // What those questions may cost per day, in Workers AI Neurons, for
  //   // the whole site. Each question's cost is counted from the tokens its
  //   // model calls used (the pick, Llama Guard reading the question, and
  //   // the reply written from the pick), and once the day's reach this no
  //   // more are asked until midnight UTC. A question still being answered
  //   // is counted at the most one has cost, so the day ends within about
  //   // one question's cost of this, however many are asked at once.
  //   // Workers AI gives 10,000 free a day. What a question costs depends
  //   // on how much your site says, since the model reads every answer:
  //   // each /ask log line has it, as `neurons`.
  //   "ASK_DAILY_NEURONS": "9000",
  //   // Questions per visitor (hashed address) per day. With ten left (or a
  //   // third of a smaller limit) they're told how many; past it, that
  //   // asking runs on a free service. The lower this is, the more
  //   // addresses it takes to use up the site's day. The addresses of one
  //   // network (an IPv4 /24, an IPv6 /48) may ask twice this between them.
  //   "ASK_VISITOR_LIMIT": "30",
  //   // How long an address (hashed) can't use /ask after an inappropriate
  //   // question. An address can be a whole office's or a phone network's,
  //   // and a model can be wrong about a question: an hour is enough to
  //   // stop someone trying things, and short for everyone else behind it.
  //   // A block ends at midnight UTC if that comes first.
  //   "ASK_BLOCK_HOURS": "1",
  //   // Where AskGuard is created: a Durable Object location hint. It is
  //   // near Workers AI in North America; it stays where it was first
  //   // created, so changing this later doesn't move it.
  //   "ASK_GUARD_LOCATION": "enam",
  //   // Each /ask log line says which answer was picked and what it cost, or
  //   // why the question was turned away, and never the visitor's address.
  //   // "true" adds what was asked (`question`), what the model made of it
  //   // before it picked (`thought`), the numbers of the lines it chose
  //   // (`chose`), the names and numbers of a reply it wrote that those
  //   // lines don't have (`unsaid`) and the reply sent (`said`), to read
  //   // under the Worker's Observability tab until Workers Logs drops them
  //   // (3 days on the free plan). Off, so visitors' words aren't kept,
  //   // unless you choose to keep them and say so.
  //   "ASK_LOG_QUESTIONS": "false",
  //   // Any Workers AI text model with function calling;
  //   // src/worker/ask/known-models.ts has the settings and the prices for
  //   // the ones it's been tried with. Another model is counted at the
  //   // dearest of those prices unless ASK_MODEL_PRICE gives its own, as
  //   // Neurons for a million tokens read and a million written:
  //   // "5500/36400".
  //   "ASK_MODEL": "@cf/zai-org/glm-4.7-flash",
  //   // The contact form's settings. A site without it can leave them as
  //   // they are. Each /contact log line says what came of a message
  //   // (sent, refused and why, or the error's code), and never who sent
  //   // it, their email or a word of what they wrote.
  //   //
  //   // Where the form's messages go: your own address, the one the
  //   // contact form's block below locks its binding to.
  //   "CONTACT_TO": "you@example.com",
  //   // The address the form's emails come from: one on a domain Email
  //   // Routing is on for. Left out, it's portfolio@ and the domain the
  //   // form was sent from, less a leading "www.". If that isn't one,
  //   // uncomment this line and set it:
  //   // "CONTACT_FROM": "portfolio@example.com",
  //   // Messages the form sends you per day (UTC), for the whole site:
  //   // past it, the form says it couldn't send, and offers your email.
  //   "CONTACT_DAILY_LIMIT": "20",
  //   // Messages per visitor (hashed address, as Ask counts them) per day.
  //   "CONTACT_VISITOR_LIMIT": "3"
  // },
  //
  // ---- Ask (optional) -------------------------------------------------------
  // // Workers AI, for /ask. Its free allowance resets daily; past it, /ask
  // // picks nothing and the page falls back to "Something else".
  // "ai": { "binding": "AI" },
  // // At most 10 questions a minute from one visitor (per Cloudflare
  // // location). namespace_id is any number, unique in your account.
  // "ratelimits": [{ "name": "ASK_LIMIT", "namespace_id": "4242", "simple": { "limit": 10, "period": 60 } }],
  //
  // ---- The contact form (optional) ------------------------------------------
  // // The form's messages go out through this binding, and only ever to
  // // destination_address: your own address, as CONTACT_TO has it,
  // // verified in the Cloudflare dashboard under Email Routing, which has
  // // to be on for your domain (docs/contact-form.md). Sending there is
  // // free on every plan.
  // "send_email": [{ "name": "CONTACT_EMAIL", "destination_address": "you@example.com" }],
  // ---- End of the Worker ----------------------------------------------------

  "assets": {
    "directory": "dist",
    // Worker: it reaches the files through this binding, and runs first
    // for /ask and /contact (otherwise only for paths with no file).
    // "binding": "ASSETS",
    // "run_worker_first": ["/ask", "/contact"],
    // Serve /404.html for paths that don't exist.
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    // Without the line Cloudflare writes for each request: it has the
    // request's headers, and the visitor's address is one of them. What
    // /ask and /contact log themselves is kept, and never has the address.
    "logs": { "invocation_logs": false }
  }
}
