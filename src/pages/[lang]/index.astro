---
/* Each language's page but the main one's (../index.astro), at /<code>/. */
import Portfolio from "../../components/Portfolio.astro";
import { site } from "../../site/current.ts";

export const getStaticPaths = () =>
  site.codes.filter((code) => code !== site.main).map((code) => ({ params: { lang: code } }));
---

<Portfolio code={Astro.params.lang} />
