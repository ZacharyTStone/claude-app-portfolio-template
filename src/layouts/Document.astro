---
/* What every page starts with, the 404 page too: the first lines of the
   <head>, the icons, the fonts loaded up front and the stylesheet. */
import "../styles/app.css";
import { REFERRER_POLICY } from "../shared/headers.ts";
import { ICONS } from "../site/constants.ts";
import { site } from "../site/current.ts";
import { pagePolicy } from "../site/hosts.ts";

interface Props {
  lang: string;
  dir?: string;
  /** Fonts the page loads up front. */
  preload: string[];
  /** Attributes for <html>. */
  data?: Record<string, string>;
}
const { lang, dir = "ltr", preload, data = {} } = Astro.props;
// Where the host sends no headers, the page carries the policy itself,
// ahead of everything it covers, and the referrer policy.
const policy = pagePolicy(site);
---

<!doctype html>
<html lang={lang} dir={dir} {...data}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {policy && (
      <>
        <meta http-equiv="Content-Security-Policy" content={policy} />
        <meta name="referrer" content={REFERRER_POLICY} />
      </>
    )}
    <slot name="head" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content={site.config.themeColor} />
    <link rel="icon" href={site.link(ICONS.svg)} type="image/svg+xml" />
    <link rel="icon" href={site.link(ICONS.png)} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={site.link(ICONS.appleTouch)} />
    {preload.map((href) => (
      <link rel="preload" href={site.link(href)} as="font" type="font/woff2" crossorigin />
    ))}
  </head>
  <body>
    <slot />
  </body>
</html>
