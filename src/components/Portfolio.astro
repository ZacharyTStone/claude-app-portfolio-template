---
/* One language's page. Every tab is in it, so it all works without JavaScript. The script gets its wording
   as data-* attributes on <html>, and the question card as JSON. */
import Document from "../layouts/Document.astro";
import { ASK_PATH } from "../contracts/ask.ts";
import { SCRIPT_STRING_NAMES, SCRIPT_STRING_ATTRIBUTES } from "../config/strings.ts";
import { DATA } from "../contracts/page-attributes.ts";
import { PAGE_CLASSES } from "../contracts/page-classes.ts";
import { PAGE_IDS } from "../contracts/page-ids.ts";
import { site } from "../site/current.ts";
import { scriptJson } from "../site/json.ts";
import { makePage } from "../site/site.ts";
import Asked from "./Asked.astro";
import Home from "./Home.astro";
import PageMeta from "./PageMeta.astro";
import Panel from "./Panel.astro";
import PrintHead from "./PrintHead.astro";
import Sidebar from "./Sidebar.astro";
import Thread from "./Thread.astro";

interface Props {
  code: string;
}
const page = makePage(site, Astro.props.code);
const { code, language } = page;
const { strings } = language;

// An optional string the language doesn't have is left off.
const scriptAttributes: Record<string, string> = {};
for (const key of SCRIPT_STRING_NAMES) {
  const wording = strings[key];
  if (wording !== undefined) scriptAttributes[SCRIPT_STRING_ATTRIBUTES[key]] = wording;
}
if (site.config.ask) scriptAttributes[DATA.ask] = site.link(ASK_PATH);
---

<Document lang={code} dir={language.dir} preload={language.meta.preload} htmlAttributes={scriptAttributes}>
  <PageMeta slot="head" page={page} />

  <a class={PAGE_CLASSES.skip} href={`#${PAGE_IDS.main}`} data-js-only>
    {strings.skip}
  </a>
  <PrintHead page={page} />

  <div class={PAGE_CLASSES.shell}>
    <Sidebar page={page} />
    <main id={PAGE_IDS.main} class="main">
      <Home page={page} />
      {language.threads.map((thread) => (
        <Thread page={page} thread={thread} />
      ))}
      <Asked page={page} />
    </main>
    <Panel page={page} />
  </div>

  <script type="application/json" id={PAGE_IDS.questionCardData} set:html={scriptJson(language.questions)} />
  <script>
    import "../app/main.ts";
  </script>
</Document>
