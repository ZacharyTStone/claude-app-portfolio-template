---
/* One language's page: the app's three columns (the sidebar, every tab,
   the details panel). Every tab is in the page, so it all works without
   JavaScript; the script adds the rest. It hands the script what it needs
   in three places: its wording as data-* attributes on <html>, the
   question card as JSON, and the names in src/contracts.
   Styles: src/styles/layout.css (the columns). */
import Document from "../layouts/Document.astro";
import { ASK_PATH } from "../contracts/ask.ts";
import { SCRIPT_STRING_NAMES, SCRIPT_STRING_ATTRIBUTES } from "../config/strings.ts";
import { DATA } from "../contracts/page-attributes.ts";
import { PAGE_CLASSES } from "../contracts/page-classes.ts";
import { PAGE_IDS } from "../contracts/page-ids.ts";
import { site } from "../site/current.ts";
import { scriptJson } from "../site/script-json.ts";
import { makePage } from "../site/site.ts";
import Asked from "./Asked.astro";
import Home from "./Home.astro";
import PageMeta from "./PageMeta.astro";
import Panel from "./Panel.astro";
import PrintHead from "./PrintHead.astro";
import Sidebar from "./Sidebar.astro";
import Thread from "./Thread.astro";

interface Props {
  /** The language's code. */
  code: string;
}
const page = makePage(site, Astro.props.code);
const { code, lang } = page;
const { strings } = lang;

// What <html> carries for the script: its wording, one data-* attribute
// each (an optional string the language doesn't have is left off), and
// where /ask is, when Ask is on.
const scriptAttributes: Record<string, string> = {};
for (const key of SCRIPT_STRING_NAMES) {
  const wording = strings[key];
  if (wording !== undefined) scriptAttributes[SCRIPT_STRING_ATTRIBUTES[key]] = wording;
}
if (site.config.ask) scriptAttributes[DATA.ask] = site.link(ASK_PATH);
---

<Document lang={code} dir={lang.dir} preload={lang.meta.preload} htmlAttributes={scriptAttributes}>
  <PageMeta slot="head" page={page} />

  <a class={PAGE_CLASSES.skip} href={`#${PAGE_IDS.main}`} data-js-only>
    {strings.skip}
  </a>
  <PrintHead page={page} />

  <div class="app">
    <Sidebar page={page} />
    <main id={PAGE_IDS.main} class="main">
      <Home page={page} />
      {lang.threads.map((thread) => (
        <Thread page={page} thread={thread} />
      ))}
      <Asked page={page} />
    </main>
    <Panel page={page} />
  </div>

  <!-- The question card's topics and the personal answers, for the script. -->
  <script type="application/json" id={PAGE_IDS.questionCardData} set:html={scriptJson(lang.questions)} />
  <script>
    import "../app/main.ts";
  </script>
</Document>
