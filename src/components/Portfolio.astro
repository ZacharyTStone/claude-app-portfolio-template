---
/* One language's page: the app's three columns (the sidebar, every tab,
   the details panel). Every tab is in the page, so it all works without
   JavaScript; the script adds the rest. */
import Document from "../layouts/Document.astro";
import { ASK_PATH } from "../shared/ask.ts";
import { DATA, dataAttribute, PAGE_CLASSES, PAGE_IDS, SCRIPT_STRINGS } from "../shared/page-data.ts";
import { site } from "../site/current.ts";
import { scriptJson } from "../site/script-json.ts";
import { makePage } from "../site/site.ts";
import Asked from "./Asked.astro";
import Home from "./Home.astro";
import PageMeta from "./PageMeta.astro";
import Panel from "./Panel.astro";
import PrintHead from "./PrintHead.astro";
import Sidebar from "./Sidebar.astro";
import Thread from "./Thread.astro";

interface Props {
  /** The language's code. */
  code: string;
}
const page = makePage(site, Astro.props.code);
const { code, lang } = page;
const { ask } = site.config;
// The script's wording, one data-* attribute each, and where Ask is.
const words = Object.fromEntries(SCRIPT_STRINGS.map((key) => [`data-${dataAttribute(key)}`, lang.strings[key]]));
if (ask) words[DATA.ask] = site.link(ASK_PATH);
---

<Document lang={code} dir={lang.dir} preload={lang.meta.preload} data={words}>
  <PageMeta slot="head" page={page} />

  <a class={PAGE_CLASSES.skip} href={`#${PAGE_IDS.main}`} data-js-only>
    {lang.strings.skip}
  </a>
  <PrintHead page={page} />

  <div class="app">
    <Sidebar page={page} />
    <main id={PAGE_IDS.main} class="main">
      <Home page={page} />
      {lang.threads.map((thread) => (
        <Thread page={page} thread={thread} />
      ))}
      <Asked page={page} />
    </main>
    <Panel page={page} />
  </div>

  <!-- The question card's topics and the personal answers, for the script. -->
  <script type="application/json" id={PAGE_IDS.questions} set:html={scriptJson(lang.questions)} />
  <script>
    import "../app/main.ts";
  </script>
</Document>
