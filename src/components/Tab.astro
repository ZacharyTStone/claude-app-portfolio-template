---
/* A tab: an <article> that :target shows, with its title and Share in the
   bar across the top, the conversation (the slot), and the composer under
   it. Every thread is one (Thread.astro), and so is "Something else"
   (Asked.astro), which the script copies for each chat and personal
   answer. Styles: src/styles/thread.css, and composer.css for the
   composer. */
import type { Pill } from "../config/language.ts";
import { DATA } from "../contracts/page-attributes.ts";
import { PAGE_CLASSES } from "../contracts/page-classes.ts";
import { PAGE_IDS, titleId } from "../contracts/page-ids.ts";
import { site } from "../site/current.ts";
import type { Page } from "../site/site.ts";
import { flag } from "./attributes.ts";
import Topbar from "./Topbar.astro";

interface Props {
  /** The language's page this is part of. */
  page: Page;
  /** The tab's address: #id. */
  id: string;
  /** The tab's name, in the bar across its top. */
  title: string;
  /** A label beside the title, if the thread has one. */
  pill?: Pill;
}
const { page, id, title, pill } = Astro.props;
const { strings } = page.language;
---

<article class={PAGE_CLASSES.tab} id={id} aria-labelledby={titleId(id)}>
  <Topbar strings={strings}>
    <h2 class={`${PAGE_CLASSES.title} ${PAGE_CLASSES.iconAfter}`} id={titleId(id)}>
      {title}
    </h2>
    {pill && (
      <span class="pill">
        {pill.live && <span class="live" />}
        {pill.label}
      </span>
    )}
    <button slot="actions" class="btn-ghost ic i-share" type="button" data-js-only {...flag(DATA.copyLink)}>
      <span class={PAGE_CLASSES.label}>{strings.share}</span>
    </button>
  </Topbar>
  <div class={PAGE_CLASSES.scroll}>
    <div class={PAGE_CLASSES.thread}>
      <slot />
    </div>
  </div>
  {/* The app's slim composer: a link home without JavaScript, and with it, the way to open the question card. */}
  <div class="dock">
    <a class={`${PAGE_CLASSES.composer} slim`} href={`#${PAGE_IDS.home}`}>
      <span class="ic i-plus" aria-hidden="true"></span>
      <span class="ph">{strings.followUpPlaceholder}</span>
    </a>
    <p class="under">
      <span class="credit">{strings.credit}</span>
      <span class="model">
        {site.config.name} <em>{strings.model}</em>
      </span>
    </p>
  </div>
</article>
