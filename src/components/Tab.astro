---
/* An <article> that shows while it's the open tab: the one a page is built with open (PAGE_CLASSES.open), and with
   JavaScript off one an old address's #id names (:target). The script copies the "Something else" tab for each
   chat. Its title is an <h1>, as the home screen's greeting is: only one of them shows at a time, so whichever
   is open, and however it was opened, the page has one <h1>, and the headings in an answer are under it. */
import type { Pill } from "../config/language.ts";
import { DATA } from "../contracts/page-attributes.ts";
import { PAGE_CLASSES } from "../contracts/page-classes.ts";
import { titleId } from "../contracts/page-ids.ts";
import { site } from "../site/current.ts";
import type { Page } from "../site/site.ts";
import { flag } from "./attributes.ts";
import Topbar from "./Topbar.astro";

interface Props {
  page: Page;
  id: string;
  title: string;
  pill?: Pill;
}
const { page, id, title, pill } = Astro.props;
const { strings } = page.language;
const isOpen = page.tab === id;
---

<article class:list={[PAGE_CLASSES.tab, { [PAGE_CLASSES.open]: isOpen }]} id={id} aria-labelledby={titleId(id)}>
  <Topbar strings={strings}>
    <h1 class={`${PAGE_CLASSES.title} ${PAGE_CLASSES.iconAfter}`} id={titleId(id)}>
      {title}
    </h1>
    {pill && (
      <span class="pill">
        {pill.live && <span class="live" />}
        {pill.label}
      </span>
    )}
    <button slot="actions" class="ghost-button icon i-share" type="button" data-js-only {...flag(DATA.copyLink)}>
      <span class={PAGE_CLASSES.label}>{strings.share}</span>
    </button>
  </Topbar>
  <div class={PAGE_CLASSES.scroll}>
    <div class={PAGE_CLASSES.thread}>
      <slot />
    </div>
  </div>
  {/* The app's slim composer: a link home without JavaScript, and with it, the way to open the question card. */}
  <div class="dock">
    <a class={`${PAGE_CLASSES.composer} slim`} href={site.pagePath(page.code)}>
      <span class="icon i-plus" aria-hidden="true"></span>
      <span class="composer-placeholder">{strings.followUpPlaceholder}</span>
    </a>
    <p class="under">
      <span class="credit">{strings.credit}</span>
      <span class="model">
        {site.config.name} <em>{strings.model}</em>
      </span>
    </p>
  </div>
</article>
