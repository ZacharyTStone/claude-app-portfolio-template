---
/* A picture, in a figure's frame: loaded when it's near the screen, at a
   size the page already knows. With `href`, it links there (in the viewer,
   if the config's `viewer` lists it, named by its caption).

   One that moves has a `still`, and is shown one of two ways:
   - A picture a visitor plays (its file says how long it plays:
     src/site/pictures.ts) is shown still, with a Play button over it. The
     button is a link to the picture as it moves, which is where it goes
     without JavaScript; with it, src/app/play.ts plays the picture in
     place.
   - Any other moves all the time, and a visitor who has asked for less
     motion is shown the still instead: the browser picks between the two,
     with no script.
   Styles: src/styles/figures.css. */
import type { Strings } from "../shared/config.ts";
import type { Picture } from "../shared/content.ts";
import { DATA, PAGE_CLASSES, REDUCED_MOTION } from "../shared/page-data.ts";
import { site } from "../site/current.ts";
import { secondsPlayed } from "../site/pictures.ts";
import { external } from "../shared/markdown.ts";
import { viewerLink } from "./attributes.ts";

interface Props {
  /** The picture, as an answer's `image` block, or one of its `images`,
      has it. */
  picture: Picture;
  /** The page's wording, for a Play button's name. */
  strings: Strings;
}
const { picture, strings } = Astro.props;
const { src, still, alt, width, height, caption, href, round } = picture;
const playsForSeconds = still ? secondsPlayed(src) : undefined;
// The same <img> whether or not a link is around it: the still, of a
// picture that's played.
const shown = still && playsForSeconds ? still : src;
const imageAttributes = { src: site.link(shown), alt, width, height, loading: "lazy", decoding: "async" } as const;
// A link, or nothing, around the picture.
const Frame = href ? "a" : Fragment;
const frameAttributes = href ? { href: site.link(href), ...external(href), ...viewerLink(href, caption ?? alt) } : {};
// What holds a picture that's played, with its button over it.
const Stage = playsForSeconds ? "div" : Fragment;
const stageAttributes = playsForSeconds ? { class: PAGE_CLASSES.stage } : {};
---

<figure class:list={[PAGE_CLASSES.figure, "shot", { round, [PAGE_CLASSES.plays]: playsForSeconds }]}>
  <Stage {...stageAttributes}>
    <Frame {...frameAttributes}>
      {still && !playsForSeconds ? (
        <picture>
          <source media={REDUCED_MOTION} srcset={site.link(still)} />
          <img {...imageAttributes} />
        </picture>
      ) : (
        <img {...imageAttributes} />
      )}
    </Frame>
    {playsForSeconds && (
      <a
        class={`${PAGE_CLASSES.playButton} ic i-play`}
        href={site.link(src)}
        {...{ [DATA.play]: String(playsForSeconds) }}
      >
        <span class={PAGE_CLASSES.label}>{strings.play}</span>
      </a>
    )}
  </Stage>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
