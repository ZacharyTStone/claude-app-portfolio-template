---
/* A picture, in a figure's frame: loaded when it's near the screen, at a
   size the page already knows. With `href`, it links there. */
import type { Picture } from "../shared/content.ts";
import { PAGE_CLASSES } from "../shared/page-data.ts";
import { site } from "../site/current.ts";
import { external } from "../shared/markdown.ts";

interface Props {
  picture: Picture;
}
const { src, alt, width, height, caption, href, round } = Astro.props.picture;
const image = { src: site.link(src), alt, width, height, loading: "lazy", decoding: "async" } as const;
---

<figure class:list={[PAGE_CLASSES.figure, "shot", { round }]}>
  {href ? (
    <a href={site.link(href)} {...external(href)}>
      <img {...image} />
    </a>
  ) : (
    <img {...image} />
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
