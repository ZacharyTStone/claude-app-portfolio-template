---
/* A picture, in a figure's frame: loaded when it's near the screen, at a
   size the page already knows. With `href`, it links there (in the viewer,
   if the config's `viewer` lists it, named by its caption).

   One that moves has a `still`, and is shown one of two ways:
   - A picture a visitor plays (its file says how long it plays:
     picture.ts) is shown still, with a Play button over it. The
     button is a link to the picture as it moves, which is where it goes
     without JavaScript; with it, src/app/play.ts plays the picture in
     place.
   - Any other moves all the time, and a visitor who has asked for less
     motion is shown the still instead: the browser picks between the two,
     with no script.
   Styles: src/styles/figures.css. */
import type { Strings } from "../config/strings.ts";
import type { Picture } from "../config/blocks.ts";
import { DATA, REDUCED_MOTION } from "../contracts/page-attributes.ts";
import { PAGE_CLASSES } from "../contracts/page-classes.ts";
import { site } from "../site/current.ts";
import { linkAttributes } from "./attributes.ts";
import { pictureMode } from "./picture.ts";

interface Props {
  /** The picture, as an answer's `image` block, or one of its `images`,
      has it. */
  picture: Picture;
  /** The page's wording, for a Play button's name. */
  strings: Strings;
}
const { picture, strings } = Astro.props;
const { src, alt, width, height, caption, href, round } = picture;
const mode = pictureMode(picture);
const isPlayed = mode.kind === "played";
const image = {
  src: site.link(isPlayed ? mode.still : src),
  alt,
  width,
  height,
  loading: "lazy",
  decoding: "async",
} as const;
const Link = href ? "a" : Fragment;
const link = href ? linkAttributes(href, caption ?? alt) : {};
const Stage = isPlayed ? "div" : Fragment;
const stage = isPlayed ? { class: PAGE_CLASSES.stage } : {};
---

<figure class:list={[PAGE_CLASSES.figure, "shot", { round, [PAGE_CLASSES.playedFigure]: isPlayed }]}>
  <Stage {...stage}>
    <Link {...link}>
      {mode.kind === "moving" ? (
        <picture>
          <source media={REDUCED_MOTION} srcset={site.link(mode.still)} />
          <img {...image} />
        </picture>
      ) : (
        <img {...image} />
      )}
    </Link>
    {mode.kind === "played" && (
      <a
        class={`${PAGE_CLASSES.playButton} icon i-play`}
        href={site.link(src)}
        {...{ [DATA.play]: String(mode.seconds) }}
      >
        <span class={PAGE_CLASSES.label}>{strings.play}</span>
      </a>
    )}
  </Stage>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
