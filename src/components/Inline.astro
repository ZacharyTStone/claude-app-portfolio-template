---
/* A line of the config's Markdown (src/config/markdown.ts), as elements.
   Its words are text, which Astro escapes, so no HTML gets through. Bold,
   italic and a link hold pieces of their own, which this draws by using
   itself. */
import { external } from "../contracts/links.ts";
import { spans, type Span } from "../config/markdown.ts";
import { site } from "../site/current.ts";

/** A line as it's written (`text`), or one already read into its pieces
    (`spans`), which is what this hands itself for what's inside bold,
    italic or a link. */
type Props = { text: string } | { spans: Span[] };

const pieces = "text" in Astro.props ? spans(Astro.props.text) : Astro.props.spans;
---

{pieces.map((piece) =>
  typeof piece === "string" ? (
    piece
  ) : piece.type === "code" ? (
    <code>{piece.text}</code>
  ) : piece.type === "strong" ? (
    <strong>
      <Astro.self spans={piece.spans} />
    </strong>
  ) : piece.type === "em" ? (
    <em>
      <Astro.self spans={piece.spans} />
    </em>
  ) : (
    <a href={site.link(piece.href)} {...external(piece.href)}>
      <Astro.self spans={piece.spans} />
    </a>
  ),
)}
