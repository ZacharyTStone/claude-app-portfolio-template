---
/* A cell of the calendar, or of its key: a rounded square in its shade, or
   none where the history has no week. A mark's tick and name are drawn at
   its cell, and under it a dot for each repo made in its week, a link to
   the repo. The strip is hidden from screen readers and the keyboard, so
   the dots are too: the row's list of repos has the same links. */
import { PAGE_CLASSES } from "../contracts/page-classes.ts";
import type { Cell } from "./history-parts.ts";

interface Props {
  cell: Cell;
}
const { level, title, mark, repos, now } = Astro.props.cell;
---

<i
  class:list={[
    level === undefined ? undefined : ["heat-0", "heat-1", "heat-2", "heat-3", "heat-4"][level],
    { "history-mark": mark, "history-mark-late": mark?.late, "history-now": now },
  ]}
  title={title}
>
  {mark && <b>{mark.label}</b>}
  {repos && (
    <span class={PAGE_CLASSES.historyPins}>
      {repos.map((repo) => (
        <a href={repo.url} tabindex="-1" title={repo.name} aria-label={repo.name} />
      ))}
    </span>
  )}
</i>
