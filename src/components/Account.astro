---
/* The menu is in the page, hidden: the script opens it, and reads the clock's and the goodbye's wording from
   the data-* attributes here. */
import { CLOCK_MOODS } from "../config/language.ts";
import { DATA, LOCAL_ZONE } from "../contracts/page-attributes.ts";
import { PAGE_CLASSES } from "../contracts/page-classes.ts";
import { PAGE_IDS } from "../contracts/page-ids.ts";
import { newTabAttributes } from "../contracts/links.ts";
import { site } from "../site/current.ts";
import type { Page } from "../site/site.ts";
import { flag } from "./attributes.ts";
import Logo from "./Logo.astro";

interface Props {
  page: Page;
}
const { code: pageLanguage, language } = Astro.props.page;
const { email, github } = site.config.links;
const {
  initial,
  name,
  sub,
  label: menuLabel,
  clock,
  language: languageRowLabel = "",
  upgrade,
  logout,
} = language.account;
const firstOtherLanguage = site.codes.find((code) => code !== pageLanguage);
const clockWording = {
  [DATA.clockAhead]: clock.ahead,
  [DATA.clockBehind]: clock.behind,
  [DATA.clockSame]: clock.same,
  ...Object.fromEntries(CLOCK_MOODS.map((mood) => [DATA.mood(mood), clock.moods[mood]])),
};
const goodbyeWording = {
  [DATA.byeTitle]: logout.title,
  [DATA.byeText]: logout.text,
  [DATA.byeBack]: logout.back,
};
---

<div class={PAGE_CLASSES.account}>
  <div class={PAGE_CLASSES.accountRow}>
    <span class="avatar" aria-hidden="true">
      {initial}
    </span>
    <span>
      {name} <span class="sub">{sub}</span>
    </span>
  </div>
  <div class="pop up" id={PAGE_IDS.accountMenu} role="menu" aria-label={menuLabel} hidden>
    <a class={PAGE_CLASSES.mailRow} role="menuitem" href={`mailto:${email}`}>
      {email}
    </a>
    <div class="pop-clock" role="menuitem" aria-disabled="true" {...flag(DATA.clock)} {...clockWording}>
      <span class="clocks">
        <span>
          <span class="pop-label">{clock.me}</span>
          <span class={PAGE_CLASSES.clockTime} {...{ [DATA.zone]: site.config.timezone }}>
            {clock.zone}
          </span>
        </span>
        <span>
          <span class="pop-label">{clock.you}</span>
          <span class={PAGE_CLASSES.clockTime} {...{ [DATA.zone]: LOCAL_ZONE }}>
            –
          </span>
        </span>
      </span>
      <span class={PAGE_CLASSES.clockNote}></span>
    </div>
    <hr />
    {firstOtherLanguage && (
      <>
        <a
          class="icon i-globe"
          role="menuitem"
          href={site.pagePath(firstOtherLanguage)}
          hreflang={firstOtherLanguage}
          {...flag(DATA.langLink)}
        >
          {languageRowLabel}
          <span class={PAGE_CLASSES.rowMeta} lang={firstOtherLanguage}>
            {site.language(firstOtherLanguage).name}
          </span>
        </a>
        <hr />
      </>
    )}
    <a class="icon i-bolt" role="menuitem" href={`#${upgrade.tab}`}>
      {upgrade.label}
      <span class={`${PAGE_CLASSES.rowMeta} pro`}>{upgrade.hire}</span>
    </a>
    {github && (
      <a role="menuitem" href={github} {...newTabAttributes(github)}>
        <Logo icon="github" hidden />
        GitHub
        <span class={`${PAGE_CLASSES.rowMeta} icon i-out`} aria-hidden="true" />
      </a>
    )}
    <hr />
    <button class="icon i-logout" type="button" role="menuitem" {...flag(DATA.logout)} {...goodbyeWording}>
      {logout.label}
    </button>
  </div>
</div>
