---
/* The bar across the top of the home screen and of every tab: the button
   that shows the tabs on a phone, then the slot (a tab's title), then the
   actions, the panel toggle first (a tab's share button goes after it, in
   the "actions" slot). Styles: src/styles/thread.css. */
import type { Strings } from "../config/strings.ts";
import { DATA } from "../contracts/page-attributes.ts";
import { PAGE_CLASSES } from "../contracts/page-classes.ts";
import { PAGE_IDS } from "../contracts/page-ids.ts";
import { flag } from "./attributes.ts";

interface Props {
  /** The page's wording, for the two buttons' labels. */
  strings: Strings;
}
const { strings } = Astro.props;
---

<header class="topbar">
  <a class={`${PAGE_CLASSES.menu} btn-ghost ic i-sidebar`} href={`#${PAGE_IDS.tabs}`} aria-label={strings.showTabs}></a>
  <slot />
  <span class="actions">
    <button
      class="icon-btn ic i-panel panel-toggle"
      type="button"
      data-js-only
      {...flag(DATA.panelToggle)}
      aria-controls={PAGE_IDS.details}
      aria-label={strings.panelToggle}
      title={strings.panelToggleTitle}
    ></button>
    <slot name="actions" />
  </span>
</header>
