---
/* "Something else": the reply to a question the site has no answer for.
   It says how to reach you, with the question in an email and in a message
   to copy for LinkedIn. The script puts the question in; here it's a sample
   (the config's asked.q), and the email and the message carry their
   wording as it is before the question is in, for the script to fill.
   Styles: src/styles/cards.css (the message to copy). */
import type { LinkCard as LinkCardBlock } from "../config/blocks.ts";
import { emailLink, withQuestion } from "../contracts/links.ts";
import { DATA } from "../contracts/page-attributes.ts";
import { PAGE_CLASSES } from "../contracts/page-classes.ts";
import { PAGE_IDS } from "../contracts/page-ids.ts";
import { site } from "../site/current.ts";
import type { Page } from "../site/site.ts";
import { shortUrl } from "../site/url.ts";
import { flag } from "./attributes.ts";
import Inline from "./Inline.astro";
import LinkCard from "./LinkCard.astro";
import MessageActions from "./MessageActions.astro";
import Tab from "./Tab.astro";

interface Props {
  /** The language's page this is part of. */
  page: Page;
}
const { page } = Astro.props;
const { strings, asked } = page.language;
const { email, linkedin } = site.config.links;

const mailLink: LinkCardBlock = {
  name: asked.mail,
  kind: email,
  href: emailLink(`mailto:${email}`, asked.subject, withQuestion(asked.email, asked.q)),
  icon: "contact",
};
// On that link, for the script: the email as it is before the question is
// put in.
const mailTemplate = { [DATA.emailBody]: asked.email, [DATA.emailSubject]: asked.subject };

// The way to ask on LinkedIn: a link to your profile, and a message to
// copy and send there. It takes all three of the config's links.linkedin,
// asked.linkedin and asked.message.
const linkedinOffer =
  linkedin && asked.linkedin && asked.message
    ? {
        link: {
          name: asked.linkedin,
          kind: shortUrl(linkedin),
          href: linkedin,
          icon: "linkedin",
        } satisfies LinkCardBlock,
        message: asked.message,
      }
    : undefined;
---

<Tab page={page} id={PAGE_IDS.asked} title={asked.title}>
  <p class={PAGE_CLASSES.question}>
    <span class={PAGE_CLASSES.srOnly}>{strings.question}</span>
    <span class={PAGE_CLASSES.askedQuestion}>{asked.q}</span>
  </p>
  <div class={PAGE_CLASSES.answer}>
    <p>
      <Inline text={asked.answer} />
    </p>
    <LinkCard link={mailLink} {...mailTemplate} />
    {linkedinOffer && (
      <>
        <LinkCard link={linkedinOffer.link} />
        <div class={PAGE_CLASSES.draft} {...{ [DATA.messageDraft]: linkedinOffer.message.text }}>
          <p class="draft-head">
            {linkedinOffer.message.label}
            <button
              class="icon-button icon i-copy"
              type="button"
              data-js-only
              {...flag(DATA.copyDraft)}
              aria-label={linkedinOffer.message.copy}
              title={linkedinOffer.message.copy}
            />
          </p>
          <p class={PAGE_CLASSES.draftText}>{withQuestion(linkedinOffer.message.text, asked.q)}</p>
        </div>
      </>
    )}
    <MessageActions strings={strings} />
  </div>
</Tab>
