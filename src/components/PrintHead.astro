---
/* Printed, the page has no sidebar or panel, so it starts with who this is and how to reach them. Hidden on
   screen. */
import { site } from "../site/current.ts";
import type { Page } from "../site/site.ts";
import { PAGE_CLASSES } from "../contracts/page-classes.ts";
import { shortUrl } from "../site/url.ts";

interface Props {
  page: Page;
}
const { code: pageLanguage, language } = Astro.props.page;
const { config } = site;
const { email, github, linkedin } = config.links;
// Where a language writes the name its own way, both: "アレックス (Alex Example)".
const nameInThisLanguage = language.person.name;
const printedName = nameInThisLanguage === config.name ? config.name : `${nameInThisLanguage} (${config.name})`;
const contacts = [email, site.pageUrl(pageLanguage), github, linkedin].filter((contact) => contact !== undefined);
---

<div class={PAGE_CLASSES.printHead}>
  <p class={PAGE_CLASSES.printName}>{printedName}</p>
  <p>{language.meta.description}</p>
  <p>{contacts.map(shortUrl).join(" · ")}</p>
</div>
