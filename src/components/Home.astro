---
/* The home screen, shown when no tab is open. Without JavaScript its box for a question is hidden, and the
   hint points at the tabs. */
import { MAX_QUESTION_LENGTH } from "../contracts/ask.ts";
import { DATA } from "../contracts/page-attributes.ts";
import { HOURS, type GreetingPart } from "../contracts/day-parts.ts";
import { PAGE_CLASSES } from "../contracts/page-classes.ts";
import { PAGE_IDS } from "../contracts/page-ids.ts";
import type { Page } from "../site/site.ts";
import Inline from "./Inline.astro";
import Topbar from "./Topbar.astro";

interface Props {
  page: Page;
}
const { language } = Astro.props.page;
const { strings } = language;
const { greeting, intro, hint, tagline, prompts = [] } = language.home;
// The box asks what the question card asks, and its button is the card's.
const { ask: cardQuestion, ui: cardWords } = language.questions;
const greetingParts = Object.keys(HOURS.greeting) as GreetingPart[];
const greetingsForScript = {
  ...Object.fromEntries(greetingParts.map((part) => [DATA.greet(part), greeting[part]])),
  ...(tagline ? { [DATA.tagline]: tagline } : {}),
};
---

<section class="home" id={PAGE_IDS.home} aria-labelledby={PAGE_IDS.greeting}>
  <Topbar strings={strings} />
  <div class={PAGE_CLASSES.homeBody} {...greetingsForScript}>
    <h1 class={PAGE_CLASSES.hello} id={PAGE_IDS.greeting}>
      {greeting.default}
    </h1>
    <p class={PAGE_CLASSES.intro}>
      <Inline text={intro} />
    </p>
    <div class={PAGE_CLASSES.homeAsk} data-js-only>
      <div class={PAGE_CLASSES.composer}>
        <input
          type="text"
          placeholder={cardQuestion}
          aria-label={cardQuestion}
          maxlength={MAX_QUESTION_LENGTH}
          autocomplete="off"
          enterkeyhint="send"
        />
        <button
          class={`${PAGE_CLASSES.homeSend} icon i-up`}
          type="button"
          aria-label={cardWords.send}
          title={cardWords.send}
        ></button>
      </div>
      {prompts.length > 0 && (
        <ul class={PAGE_CLASSES.prompts}>
          {prompts.map((prompt) => (
            <li>
              <button type="button" {...{ [DATA.prompt]: prompt.answer }}>
                {prompt.q}
              </button>
            </li>
          ))}
        </ul>
      )}
    </div>
    {hint && <p class="hint icon i-back">{hint}</p>}
    <p class="under">
      <span class="credit">{strings.credit}</span>
    </p>
  </div>
</section>
