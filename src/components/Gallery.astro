---
import type { Picture as PictureBlock } from "../config/blocks.ts";
import type { Page } from "../site/site.ts";
import Picture from "./Picture.astro";

interface Props {
  pictures: PictureBlock[];
  /** The page it's on. */
  page: Page;
}
const { pictures, page } = Astro.props;
---

<div class="gallery">
  {pictures.map((picture) => (
    <Picture picture={picture} page={page} />
  ))}
</div>
