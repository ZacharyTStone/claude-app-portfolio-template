---
/* The script remembers a section's place and fold by its heading's id, so the id is made from the section's
   name in the config. */
import type { Panel } from "../config/language.ts";
import { PAGE_CLASSES } from "../contracts/page-classes.ts";
import { panelId } from "../contracts/page-ids.ts";

interface Props {
  name: keyof Panel;
  title: string;
}
const { name, title } = Astro.props;
---

<section aria-labelledby={panelId(name)}>
  <h2 class={PAGE_CLASSES.iconAfter} id={panelId(name)}>
    {title}
  </h2>
  <slot />
</section>
