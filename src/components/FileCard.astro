---
/* A file card: a small config file of key: value lines, with comments.
   The lines are laid out in src/site/card.ts (cardRows), which works out
   the spaces that line the values and the comments up in columns.
   Styles: src/styles/cards.css; its lines are written out one after
   another as it's scrolled to (src/app/reveal-on-scroll.ts, src/styles/motion.css). */
import type { FileCard } from "../config/blocks.ts";
import { PAGE_CLASSES } from "../contracts/page-classes.ts";
import { cardRows } from "../site/card.ts";

interface Props {
  /** The card, as an answer's `card` block or a status line has it. */
  card: FileCard;
}
const { card } = Astro.props;
const rows = cardRows(card);
---

<div class={PAGE_CLASSES.fileCard}>
  <p class="file-card-head icon i-file">
    {card.file}
    <span class="ok">✓</span>
  </p>
  {/* In a <pre> every space and line break is kept, so each line's parts are a list, not lines of markup.
      Each line is in a span of its own (.file-card-line), which the stylesheet writes out one after another. */}
  <pre>{rows.map((row, rowIndex) => [
    rowIndex > 0 && "\n",
    <span class="file-card-line">{[
      row.key && <span class="file-card-key">{row.key}:</span>,
      row.indent,
      <span class={row.accent ? "file-card-accent" : "file-card-string"}>{row.value}</span>,
      row.comment && [row.beforeComment, <span class="file-card-comment"># {row.comment}</span>],
    ]}</span>,
  ])}</pre>
</div>
