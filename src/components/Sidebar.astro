---
import { DATA } from "../contracts/page-attributes.ts";
import { groupId, PAGE_IDS } from "../contracts/page-ids.ts";
import { PAGE_CLASSES } from "../contracts/page-classes.ts";
import { site } from "../site/current.ts";
import { tabHref } from "../site/pages.ts";
import type { Page } from "../site/site.ts";
import Account from "./Account.astro";
import { flag, languageLinkAttributes } from "./attributes.ts";

interface Props {
  page: Page;
}
const { page } = Astro.props;
const { code: pageLanguage } = page;
const { config, codes: languageCodes } = site;
const { strings, sidebar } = page.language;
const { newTab, nav, groups } = sidebar;
const home = site.pagePath(pageLanguage);
// On a page in another language, the name is marked as its own.
const nameLang = config.nameLang && config.nameLang !== pageLanguage ? config.nameLang : undefined;
const hasLanguageSwitch = languageCodes.length > 1;
const languageSwitch = languageCodes.map((code) => {
  const { label, name } = site.language(code);
  return { code, label, name, link: languageLinkAttributes(code, page.tab), isThisPage: code === pageLanguage };
});
// The open tab's row is the sidebar's current one: its first, as a thread can be at the top and in a group too.
const currentRow = [...nav, ...groups.flatMap((group) => group.tabs)].find((row) => row.tab === page.tab);
const ariaCurrent = (row: { tab: string }) => (row === currentRow ? "page" : undefined);
---

<nav class="side" id={PAGE_IDS.sidebar} aria-label={strings.tabs}>
  <div class="brand">
    <button
      class="icon-button icon i-sidebar side-toggle"
      type="button"
      data-js-only
      {...flag(DATA.sideToggle)}
      aria-controls={PAGE_IDS.sidebar}
      aria-expanded="true"
      aria-label={strings.hideTabs}
      title={strings.hideTabs}
    ></button>
    <a class={PAGE_CLASSES.wordmark} href={home} lang={nameLang}>
      {config.name}
    </a>
    {hasLanguageSwitch && (
      <span class={PAGE_CLASSES.languageSwitch}>
        {languageSwitch.map((language) =>
          language.isThisPage ? (
            <span aria-current="true">{language.label}</span>
          ) : (
            <a
              {...language.link}
              hreflang={language.code}
              lang={language.code}
              {...{ [DATA.languageName]: language.name }}
            >
              {language.label}
            </a>
          ),
        )}
      </span>
    )}
    <a
      class={`${PAGE_CLASSES.drawerClose} ghost-button icon i-close`}
      href={`#${PAGE_IDS.main}`}
      aria-label={strings.closeTabs}
    ></a>
  </div>

  <ul class={PAGE_CLASSES.nav}>
    <li>
      <a class={`${PAGE_CLASSES.newTab} icon i-plus`} href={home}>
        {newTab}
      </a>
    </li>
    {nav.map((navRow) => (
      <li>
        <a
          class={`icon i-${navRow.icon}`}
          href={tabHref(site, pageLanguage, navRow.tab)}
          aria-current={ariaCurrent(navRow)}
        >
          {navRow.label}
        </a>
      </li>
    ))}
  </ul>

  {groups.map((group) => (
    <>
      <p class={PAGE_CLASSES.groupHeading} id={groupId(group.id)}>
        {group.label}
      </p>
      <ul class={PAGE_CLASSES.groupRows} aria-labelledby={groupId(group.id)}>
        {group.tabs.map((tabRow) => (
          <li>
            <a href={tabHref(site, pageLanguage, tabRow.tab)} aria-current={ariaCurrent(tabRow)}>
              <span class={PAGE_CLASSES.rowName}>
                {tabRow.title}
                {tabRow.live && (
                  <>
                    {" "}
                    <span class="live" title={tabRow.live} />
                  </>
                )}
              </span>
              <span class={PAGE_CLASSES.rowHint}>{tabRow.subtitle}</span>
            </a>
          </li>
        ))}
      </ul>
    </>
  ))}

  <Account page={page} />
</nav>
