---
import type { PanelRow } from "../config/language.ts";
import { PAGE_CLASSES } from "../contracts/page-classes.ts";
import { linkAttributes } from "./attributes.ts";
import { iconClass } from "./logos.ts";
import Logo from "./Logo.astro";

interface Props {
  row: PanelRow;
}
const { label, meta, icon, href } = Astro.props.row;
const RowElement = href ? "a" : "span";
const link = href ? linkAttributes(href, label) : {};
---

<RowElement class={iconClass(icon)} {...link}>
  <Logo icon={icon} hidden />
  {label}
  <span class={PAGE_CLASSES.rowMeta}>{meta}</span>
</RowElement>
