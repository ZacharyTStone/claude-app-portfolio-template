---
import { ACTIVITY_SECTION } from "../config/activity.ts";
import { DATA } from "../contracts/page-attributes.ts";
import { PAGE_CLASSES } from "../contracts/page-classes.ts";
import { PAGE_IDS } from "../contracts/page-ids.ts";
import { activityRows } from "../site/activity/rows.ts";
import { contextLists } from "../site/context-links.ts";
import { site } from "../site/current.ts";
import { tabHref } from "../site/pages.ts";
import type { Page } from "../site/site.ts";
import { flag } from "./attributes.ts";
import PanelRow from "./PanelRow.astro";
import PanelSection from "./PanelSection.astro";

interface Props {
  page: Page;
}
const { code, language, tab } = Astro.props.page;
const { strings, panel } = language;
const { progress } = panel;
const SECTIONS_OF_ROWS_IN_ORDER = ["outputs", "context"] as const;
const sectionsOfRows = SECTIONS_OF_ROWS_IN_ORDER.flatMap((name) => {
  const section = panel[name];
  return section ? [{ name, title: section.title, rows: section.rows }] : [];
});
// With panel.context.fromAnswers, the links the answers use, a list for each tab, above Context's own rows. The
// page shows its open tab's (none on the home page), and the script the one for each tab it opens. They and the
// rows are in one <div>: what the section's heading folds is the one element after it (src/app/folding.ts).
const gatheredLists = contextLists(site, code);
// The activity the build fetched, after the config's own sections:
// none on a site without `activity`, or with no recent public pushes.
const { activity, timezone } = site.config;
const activityRowsHere = activity ? activityRows(site.repos, activity, code, timezone) : [];
---

<aside class="panel" id={PAGE_IDS.panel} aria-label={strings.panel}>
  <button
    class="icon-button icon i-close panel-close"
    type="button"
    data-js-only
    {...flag(DATA.panelToggle)}
    aria-controls={PAGE_IDS.panel}
    aria-label={strings.closePanel}
    title={strings.closePanelTitle}
  ></button>
  {progress && (
    <PanelSection name="progress" title={progress.title}>
      <ol class="steps">
        {progress.steps.map((step) => (
          <li>
            <a href={tabHref(site, code, step.tab)}>
              <span class:list={["tick", { now: step.now }]} aria-hidden="true" />
              <span>
                {step.title}
                <span class="when">{step.when}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </PanelSection>
  )}
  {sectionsOfRows.map((section) => {
    const Rows = section.name === "context" && gatheredLists.length > 0 ? "div" : Fragment;
    return (
      <PanelSection name={section.name} title={section.title}>
        <Rows>
          {section.name === "context" &&
            gatheredLists.map((list) => (
              <ul class={PAGE_CLASSES.panelRows} {...{ [DATA.contextOf]: list.of }} hidden={list.of !== tab}>
                {list.rows.map((row) => (
                  <li>
                    <PanelRow row={row} code={code} />
                  </li>
                ))}
              </ul>
            ))}
          {section.rows.length > 0 && (
            <ul class={PAGE_CLASSES.panelRows}>
              {section.rows.map((row) => (
                <li>
                  <PanelRow row={row} code={code} />
                </li>
              ))}
            </ul>
          )}
        </Rows>
      </PanelSection>
    );
  })}
  {activityRowsHere.length > 0 && (
    <PanelSection name={ACTIVITY_SECTION} title={strings.activityTitle ?? ""}>
      <ul class={PAGE_CLASSES.panelRows}>
        {activityRowsHere.map((row) => (
          <li>
            <PanelRow row={row} code={code} fetched />
          </li>
        ))}
      </ul>
    </PanelSection>
  )}
</aside>
