---
/* The details panel on the right: the career at a glance (`progress`),
   then files and links as rows (`outputs` and `context`). It's drawn from
   the language's `panel` in the config, where each section is optional:
   one that's left out isn't drawn. Styles: src/styles/panel.css. */
import { DATA } from "../contracts/page-attributes.ts";
import { PAGE_CLASSES } from "../contracts/page-classes.ts";
import { PAGE_IDS } from "../contracts/page-ids.ts";
import type { Page } from "../site/site.ts";
import { flag } from "./attributes.ts";
import PanelRow from "./PanelRow.astro";
import PanelSection from "./PanelSection.astro";

interface Props {
  /** The language's page this is part of. */
  page: Page;
}
const { strings, panel } = Astro.props.page.language;
const { progress } = panel;
/** The sections that are lists of rows, in the order they're drawn. */
const LIST_SECTION_NAMES = ["outputs", "context"] as const;
// Those of them the config has.
const listSections = LIST_SECTION_NAMES.flatMap((name) => {
  const section = panel[name];
  return section ? [{ name, title: section.title, rows: section.rows }] : [];
});
---

<aside class="panel" id={PAGE_IDS.panel} aria-label={strings.panel}>
  <button
    class="icon-button icon i-close panel-close"
    type="button"
    data-js-only
    {...flag(DATA.panelToggle)}
    aria-controls={PAGE_IDS.panel}
    aria-label={strings.closePanel}
    title={strings.closePanelTitle}
  ></button>
  {progress && (
    <PanelSection name="progress" title={progress.title}>
      <ol class="steps">
        {progress.steps.map((step) => (
          <li>
            <a href={`#${step.tab}`}>
              <span class:list={["tick", { now: step.now }]} aria-hidden="true" />
              <span>
                {step.title}
                <span class="when">{step.when}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </PanelSection>
  )}
  {listSections.map((section) => (
    <PanelSection name={section.name} title={section.title}>
      <ul class={PAGE_CLASSES.panelRows}>
        {section.rows.map((row) => (
          <li>
            <PanelRow row={row} />
          </li>
        ))}
      </ul>
    </PanelSection>
  ))}
</aside>
