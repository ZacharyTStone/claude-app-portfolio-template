---
import type { Strings } from "../config/strings.ts";
import type { Block, BlockByKind } from "../config/blocks.ts";
import Bars from "./Bars.astro";
import FileCard from "./FileCard.astro";
import Flow from "./Flow.astro";
import Gallery from "./Gallery.astro";
import Heading from "./Heading.astro";
import Inline from "./Inline.astro";
import LinkCard from "./LinkCard.astro";
import Picture from "./Picture.astro";
import Quote from "./Quote.astro";

interface Props {
  block: Block;
  /** The page's wording, for a picture's Play button. */
  strings: Strings;
}
const { block, strings } = Astro.props;

const byKind: Partial<BlockByKind> = typeof block === "object" && !Array.isArray(block) ? block : {};
const { card, link, bars, flow, image, images, quote, heading, ...kindsNotDrawn } = byKind;
// A kind added to Block and not drawn below would be left in here, and this line would be a type error.
kindsNotDrawn satisfies Record<string, never>;
---

{typeof block === "string" && (
  <p>
    <Inline text={block} />
  </p>
)}
{Array.isArray(block) && (
  <ul>
    {block.map((item) => (
      <li>
        <Inline text={item} />
      </li>
    ))}
  </ul>
)}
{card && <FileCard card={card} />}
{link && <LinkCard link={link} />}
{bars && <Bars bars={bars} />}
{flow && <Flow flow={flow} />}
{image && <Picture picture={image} strings={strings} />}
{images && <Gallery pictures={images} strings={strings} />}
{quote && <Quote quote={quote} />}
{heading && <Heading heading={heading} />}
