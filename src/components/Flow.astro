---
/* The arrow from each step to the next is the stylesheet's. */
import type { Flow } from "../config/blocks.ts";
import { PAGE_CLASSES } from "../contracts/page-classes.ts";

interface Props {
  flow: Flow;
}
const { title, steps } = Astro.props.flow;
---

<figure class={`${PAGE_CLASSES.figure} flow`}>
  <figcaption>{title}</figcaption>
  <ol>
    {steps.map((step) => (
      <li>
        <b>{step.name}</b>
        {step.note && <span>{step.note}</span>}
      </li>
    ))}
  </ol>
</figure>
