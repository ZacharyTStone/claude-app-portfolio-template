{
  "name": "claude-app-portfolio-site",
  "private": true,
  "description": "A portfolio laid out like the Claude app, built by Astro from site.config.ts.",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "verify": "node scripts/verify.ts",
    "update-template": "node scripts/update-template.ts",
    "typecheck": "astro check && tsc -p . && tsc -p src/app && tsc -p src/worker && tsc -p src/worker/tsconfig.test.json && tsc -p tests/browser",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:browser": "playwright test",
    "fonts": "node scripts/fonts.ts",
    "fonts:check": "node scripts/fonts.ts --check",
    "diagrams": "node scripts/diagrams.ts",
    "format": "prettier --write \"**/*.{ts,json,astro}\"",
    "lint": "prettier --check \"**/*.{ts,json,astro}\"",
    "lint:html": "html-validate dist"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "5.20261104.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "astro": "^7.4.10",
    "esbuild": "0.28.2",
    "html-validate": "11.18.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "es-toolkit": "1.53.2",
    "ipaddr.js": "2.5.0",
    "valibot": "1.5.0"
  }
}
